# ============================================
# 语义层 Text-to-SQL 系统 —— 环境变量模板
# 使用：cp .env.example .env，按需修改
# ============================================

# ==================== 服务配置 ====================

# 后端监听端口（容器内默认 5001）
BACKEND_PORT=5001

# Flask 运行模式：production / development
FLASK_ENV=production

# ==================== LLM API 配置 ====================
# 留空则自动降级为 Mock 模式（内置题库 + 真实 SQLite 执行）

# ---- 火山引擎方舟（豆包 / Doubao）----
# LLM_API_KEY=你的方舟APIKey
# LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# LLM_MODEL=ep-xxxxxxxxxxxxx

# ---- OpenAI 官方 ----
# LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# ---- DeepSeek ----
# LLM_API_KEY=你的DeepSeekKey
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat

# 温度固定为 0（保证实验可复现）
LLM_TEMPERATURE=0

# LLM 请求超时（秒）与重试次数
LLM_TIMEOUT=30
LLM_MAX_RETRIES=2

# ==================== 数据源配置 ====================
# 数据源类型：
#   currentLocal  —— 本地 SQLite（默认，真实可用）
#   fengshenBi    —— 风神 BI（占位 Mock，待真实接入）
DATASOURCE_TYPE=currentLocal

# 本地 SQLite 数据库路径（Docker 中默认挂载到 /app/data/processed/retail.db）
SQLITE_DB_PATH=

# ==================== 风神 BI 配置（占位，预留）====================
# 当前为 Mock 模式，填入凭证后仍返回模拟数据。
# 后续替换为真实 API 时，只需修改 fengshenbi_provider.py 实现。
# FENGSHEN_BI_BASE_URL=
# FENGSHEN_BI_APP_ID=
# FENGSHEN_BI_APP_SECRET=
# FENGSHEN_BI_TOKEN=
# FENGSHEN_BI_WORKSPACE_ID=
