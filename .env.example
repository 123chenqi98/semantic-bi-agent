# ============================================
# 语义层 Text-to-SQL 系统 —— 环境变量模板
# 使用：cp .env.example .env，按需修改
# ============================================

# ==================== 服务配置 ====================

# 后端监听端口（容器内默认 5001）
BACKEND_PORT=5001

# Flask 运行模式：production / development
FLASK_ENV=production

# ==================== LLM API 配置 ====================
# 留空则自动降级为 Mock 模式（内置题库 + 真实 SQLite 执行）

# ---- 火山引擎方舟（豆包 / Doubao）----
# LLM_API_KEY=你的方舟APIKey
# LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# LLM_MODEL=ep-xxxxxxxxxxxxx

# ---- OpenAI 官方 ----
# LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# ---- DeepSeek ----
# LLM_API_KEY=你的DeepSeekKey
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat

# 温度固定为 0（保证实验可复现）
LLM_TEMPERATURE=0

# LLM 请求超时（秒）与重试次数
LLM_TIMEOUT=30
LLM_MAX_RETRIES=2

# ==================== 数据源配置 ====================
# 数据源类型：
#   currentLocal  —— 本地 SQLite（默认，真实可用，零售示例库 retail.db）
#   fengshenBi    —— 风神 BI（企业级接入层：架构/授权/分阶段问数已就绪，
#                     真实 OpenAPI 端点待文档填充，未接入时取数为明确标注的 Mock）
DATASOURCE_TYPE=currentLocal

# 本地 SQLite 数据库路径（Docker 中默认挂载到 /app/data/processed/retail.db）
SQLITE_DB_PATH=

# ==================== 风神 BI（Fengshen BI）企业级接入配置 ====================
# 说明：
#   1) 以下变量也可不填——系统会在「企业 BI 问数」页 / 系统设置中通过表单配置，
#      凭证由后端内存托管（密钥不明文回显、不写入浏览器本地存储），服务重启后需重新填写。
#      生产环境建议通过环境变量 / 后端密钥管理服务注入，而非前端表单。
#   2) 鉴权二选一：① 直接配置长期 FENGSHEN_BI_TOKEN；
#                  ② 配置 FENGSHEN_BI_APP_ID + FENGSHEN_BI_APP_SECRET，由系统动态换取 token。
#   3) ⚠️ 真实取数还需在 src/datasource/fengshenbi_provider.py 的 API_ENDPOINTS 中
#      填充风神 BI OpenAPI 真实端点（当前全部为 None + TODO，严禁伪造）。
#      端点未填充前：配置凭证后状态为「已配置·待联调」，取数仍返回明确标注的模拟数据。
#
# [必填] 风神 BI OpenAPI 基础地址（例如 https://bi.example.com/openapi）
# FENGSHEN_BI_BASE_URL=
# [必填] 工作空间 ID（多租户/项目空间标识）
# FENGSHEN_BI_WORKSPACE_ID=
# [鉴权二选一] 应用 ID + 应用密钥（用于动态换取 access_token）
# FENGSHEN_BI_APP_ID=
# FENGSHEN_BI_APP_SECRET=
# [鉴权二选一] 直接下发的长期访问令牌（配置后优先使用，无需 app_id/secret）
# FENGSHEN_BI_TOKEN=
