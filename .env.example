# ============================================
# LLM API 配置（基线系统 & 实验组 Agent 共用）
# 使用：复制此文件为 .env，然后修改为你自己的 Key
#       然后执行 source .env
# ============================================

# ---- OpenAI 官方（示例）----
# export LLM_API_KEY="sk-xxxxxxxxxxxxxxxxxxxxxxxx"
# export LLM_BASE_URL="https://api.openai.com/v1"
# export LLM_MODEL="gpt-4o-mini"

# ---- 火山引擎方舟（豆包 / Doubao）----
# export LLM_API_KEY="你的方舟APIKey"
# export LLM_BASE_URL="https://ark.cn-beijing.volces.com/api/v3"
# export LLM_MODEL="ep-xxxxxxxxxxxxx"  # 你的接入点ID

# ---- 智谱 GLM ----
# export LLM_API_KEY="你的智谱APIKey"
# export LLM_BASE_URL="https://open.bigmodel.cn/api/paas/v4"
# export LLM_MODEL="glm-4-flash"

# ---- 阿里云百炼（通义千问）----
# export LLM_API_KEY="你的百炼APIKey"
# export LLM_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"
# export LLM_MODEL="qwen-plus"

# ---- DeepSeek ----
# export LLM_API_KEY="你的DeepSeek APIKey"
# export LLM_BASE_URL="https://api.deepseek.com/v1"
# export LLM_MODEL="deepseek-chat"

# 温度固定为 0（保证可复现，实验必须）
export LLM_TEMPERATURE=0
