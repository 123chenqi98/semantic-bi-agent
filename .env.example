# ============================================
# 语义层 Text-to-SQL 系统 —— 环境变量模板
# 使用：cp .env.example .env，按需修改
# ============================================

# ==================== 服务配置 ====================

# 后端监听端口（容器内默认 5001）
BACKEND_PORT=5001

# Flask 运行模式：production / development
FLASK_ENV=production

# ==================== LLM API 配置 ====================
# 留空则自动降级为 Mock 模式（内置题库 + 真实 SQLite 执行）

# ---- 火山引擎方舟（豆包 / Doubao）----
# LLM_API_KEY=你的方舟APIKey
# LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# LLM_MODEL=ep-xxxxxxxxxxxxx

# ---- OpenAI 官方 ----
# LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# ---- DeepSeek ----
# LLM_API_KEY=你的DeepSeekKey
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat

# 温度固定为 0（保证实验可复现）
LLM_TEMPERATURE=0

# LLM 请求超时（秒）与重试次数
LLM_TIMEOUT=30
LLM_MAX_RETRIES=2

# ==================== 数据源配置 ====================
# 数据源类型：
#   currentLocal  —— 本地 SQLite（默认，真实可用，零售示例库 retail.db）
#   fengshenBi    —— 风神 BI（企业级接入层：架构/授权/分阶段问数已就绪；
#                     「取数」走风神 MCP 服务（见下方 MCP 配置），OpenAPI 仅用于嵌入/治理；
#                     未接入 MCP 时取数为明确标注的 Mock，不影响演示链路）
DATASOURCE_TYPE=currentLocal

# 本地 SQLite 数据库路径（Docker 中默认挂载到 /app/data/processed/retail.db）
SQLITE_DB_PATH=

# ==================== 风神 BI（Fengshen BI）企业级接入配置 ====================
# 两类接口（重要区别，详见 docs/部署与企业BI接入说明.md「风神 MCP 真实接入指引」）：
#   · OpenAPI（REST）：仪表盘嵌入 + 用户/权限/行列权限/角色/审批流治理，【不含执行 SQL 取数】；
#   · MCP 服务（标准 MCP 协议）：真正「取数」通道，3 个工具——
#       get_data_set_by_appid（数据集列表）/ get_schema（字段 schema）/ query_data_by_sql（SQL 取数）。
#
# 通用说明：
#   1) 以下变量也可不填——系统在「企业 BI 问数」页 / 系统设置中提供表单，
#      凭证由后端内存托管（密钥不明文回显、不写入浏览器本地存储），服务重启后需重新填写。
#      生产建议通过环境变量 / 后端密钥管理服务注入。
#   2) ⚠️ 风神 MCP 取数目前为「邀测试用」，且仅在字节内网可达：
#        - 内网：byted_mcp_client（PSM=data.aeolus.data_set_query, region=cn）+ sophon api_key；
#        - 公网/跨网：需自行部署一个可达的 MCP over HTTP 网关，填 FENGSHEN_BI_MCP_GATEWAY_URL。
#      公网阿里云 ECS 无法直连内网 PSM；未配置网关时状态为「已配置·待内网联调」，取数回退 Mock。
#   3) 限流：MCP QPM ≤ 3（每分钟最多 3 次）、仅中国区、大表超资源会失败。
#
# ---- 【OpenAPI / 嵌入 / 通用】（取数非必需，嵌入/治理场景才用）----
# 风神 BI OpenAPI 基础地址（站点 Origin 已确认为 https://data.bytedance.net，具体 API 前缀待官方文档）
# FENGSHEN_BI_BASE_URL=https://data.bytedance.net
# 工作空间 / 项目 ID（MCP 的 appId 取此值；仪表盘链接中 appId=1000821，可作项目 ID 参考）
# FENGSHEN_BI_WORKSPACE_ID=1000821
# FENGSHEN_BI_APP_ID=1000821
# FENGSHEN_BI_APP_SECRET=
# 直接下发的长期访问令牌（OpenAPI 鉴权二选一，配置后优先使用）
# FENGSHEN_BI_TOKEN=
#
# ---- 【风神 MCP 取数（真实取数通道）】----
# [必填] 项目 ID（即 get_data_set_by_appid 的 appId）：默认复用 FENGSHEN_BI_WORKSPACE_ID / APP_ID
# [鉴权] 调用方用户 JWT（按该用户数据权限返回，MCP 的 Authorization 入参）；
#        也可改用 clientId+clientSecret 由网关换 JWT（二选一，推荐显式配置 user_jwt）
# FENGSHEN_BI_USER_JWT=
# [鉴权] 开发者后台申请的应用凭证（CN 区）：https://data.bytedance.net/aeolus#/developer/console/certification
# FENGSHEN_BI_CLIENT_ID=
# FENGSHEN_BI_CLIENT_SECRET=
# [内网] sophon 平台 api_key（内网 LLM/MCP 网关鉴权用）：https://sophon-ai.bytedance.net/paas/token
# FENGSHEN_BI_SOPHON_API_KEY=
# [传输] MCP 服务 PSM 与区域（默认值如下，一般无需修改；仅中国区）
# FENGSHEN_BI_MCP_PSM=data.aeolus.data_set_query
# FENGSHEN_BI_MCP_REGION=cn
# [传输·公网/跨网必填] MCP over HTTP(S) 网关地址：配置后走标准 MCP JSON-RPC 真实取数；
#   留空则认为只能走内网 PSM（公网 ECS 不可达），取数回退 Mock。
# FENGSHEN_BI_MCP_GATEWAY_URL=
